page {
  background: #f7f3e4;
  background-image:
    radial-gradient(circle at 12% 14%, rgba(95, 141, 124, 0.07) 0, transparent 30%),
    radial-gradient(circle at 88% 84%, rgba(232, 162, 61, 0.07) 0, transparent 35%);
  font-family: "Kaiti SC", "STKaiti", "KaiTi", "Microsoft YaHei", serif;
  font-size: 28rpx;
  color: #4a3b2a;
}

/* 奶油卡片：Q 版圆角 + 淡青描边 */
.card {
  background: #fffdf6;
  border: 2rpx solid #e0d6ba;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(95, 141, 124, 0.12);
  padding: 24rpx;
  margin: 20rpx 24rpx;
  position: relative;
}

/* 竹节标题：青玉色 */
.sec-title {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin: 28rpx 32rpx 8rpx;
  font-weight: 700;
  color: #4e7a68;
  letter-spacing: 4rpx;
}
.sec-title::before {
  content: "";
  width: 10rpx;
  height: 30rpx;
  background: linear-gradient(#6fae8f, #5f8d7c);
  border-radius: 5rpx;
}

.btn {
  background: linear-gradient(180deg, #6fae8f, #5f8d7c);
  color: #fffdf6;
  border-radius: 999rpx;
  padding: 18rpx 0;
  text-align: center;
  font-size: 30rpx;
  letter-spacing: 6rpx;
  border: 1rpx solid #4e7a68;
  box-shadow: 0 3rpx 8rpx rgba(95, 141, 124, 0.35);
}
.btn::after { border: none; }
.btn-plain {
  background: #fffdf6;
  color: #4e7a68;
  border: 2rpx solid #6fae8f;
  box-shadow: none;
}

.search-bar { display: flex; gap: 16rpx; padding: 20rpx 24rpx; }
.search-bar input {
  flex: 1;
  background: #fffdf6;
  border: 2rpx solid #d8cba8;
  border-radius: 999rpx;
  padding: 14rpx 26rpx;
  font-size: 28rpx;
  color: #4a3b2a;
}

.tag {
  display: inline-block;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  margin-right: 8rpx;
  color: #fffdf6;
  border: 1rpx solid rgba(0, 0, 0, 0.06);
}
.dim { color: #8a7a63; font-size: 24rpx; }
.gold { color: #c07b28; font-weight: 600; }

/* 顶部页头（内页复用）：青瓷色 */
.page-head {
  background: linear-gradient(180deg, #6fae8f, #5f8d7c 70%, #527e6e);
  color: #fdf9ec;
  padding: 30rpx 32rpx 24rpx;
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  border-bottom: 4rpx solid #e8a23d;
}
.page-head-title { font-size: 38rpx; font-weight: 700; letter-spacing: 6rpx; }
.page-head-sub { font-size: 22rpx; opacity: 0.8; }

.tabs {
  display: flex;
  background: #fffdf6;
  border-bottom: 3rpx solid #e0d6ba;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  color: #8a7a63;
  position: relative;
}
.tab.on {
  color: #4e7a68;
  font-weight: 700;
}
.tab.on::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  background: #e8a23d;
  border-radius: 3rpx;
}

/* 搜索框右侧清空按钮（全局通用） */
.clear-x {
  width: 44rpx;
  height: 44rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  background: #e8e0cc;
  color: #7d6a52;
  font-size: 30rpx;
  flex-shrink: 0;
  align-self: center;
}
