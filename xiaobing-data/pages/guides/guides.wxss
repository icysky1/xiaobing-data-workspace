.g-item { padding: 22rpx 24rpx; }
.g-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #3f6355;
}
.g-summary {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
}
.g-foot {
  margin-top: 14rpx;
  display: flex;
  justify-content: flex-end;
  align-items: center;
  font-size: 22rpx;
}
.g-more { color: #b05a1a; font-weight: 600; }
.g-pin {
  display: inline-block;
  vertical-align: 2rpx;
  margin-right: 10rpx;
  padding: 2rpx 12rpx;
  font-size: 20rpx;
  font-weight: 600;
  color: #fff;
  background: #c85f50;
  border-radius: 6rpx;
}
