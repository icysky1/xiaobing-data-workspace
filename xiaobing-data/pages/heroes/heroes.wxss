.hint { padding: 8rpx 28rpx; }
/* 朝代筛选：多行平铺，不再横向滚动 */
.era-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  padding: 14rpx 24rpx;
  background: #fffdf6;
  border-bottom: 2rpx solid #e0d6ba;
}
.era-tab {
  padding: 7rpx 16rpx;
  font-size: 22rpx;
  line-height: 1.4;
  color: #6b5d48;
  background: #f2ecd9;
  border: 1rpx solid #d8cba8;
  border-radius: 999rpx;
}
.era-tab.on { background: #5f8d7c; color: #fff; border-color: #5f8d7c; font-weight: 600; }
.h-grid { display: flex; flex-wrap: wrap; gap: 14rpx; }
.h-chip {
  width: calc(25% - 11rpx);
  background: #fffdf6;
  border: 2rpx solid;
  border-radius: 14rpx;
  padding: 14rpx 6rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
}
.h-dot { width: 18rpx; height: 18rpx; border-radius: 50%; margin-bottom: 8rpx; }
.h-name { font-size: 24rpx; font-weight: 600; text-align: center; }
.h-title { font-size: 18rpx; text-align: center; margin-top: 2rpx; }
