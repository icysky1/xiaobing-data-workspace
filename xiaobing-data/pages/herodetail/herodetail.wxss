.detail { padding-bottom: 30rpx; }
.hero-card {
  margin: 24rpx;
  border-radius: 20rpx;
  padding: 36rpx 24rpx 28rpx;
  text-align: center;
  color: #fff;
  box-shadow: inset 0 0 0 3rpx rgba(255, 255, 255, 0.35), 0 6rpx 16rpx rgba(74, 59, 42, 0.25);
}
.hc-name { font-size: 42rpx; font-weight: 700; letter-spacing: 4rpx; text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.25); }
.hc-sub { font-size: 24rpx; opacity: 0.9; margin-top: 6rpx; }

.kv { display: flex; padding: 10rpx 0; border-bottom: 1rpx dashed #e3d9bd; }
.kv.col { flex-direction: column; gap: 4rpx; }
.k { color: #8a7a63; width: 160rpx; font-size: 26rpx; flex-shrink: 0; }
.kv.col .k { width: auto; font-weight: 600; color: #4a3b2a; }
.v { flex: 1; font-size: 26rpx; }
.pre { white-space: pre-line; }

.sec-label { font-weight: 700; color: #4e7a68; margin-bottom: 10rpx; }

.f-line { padding: 8rpx 0; border-bottom: 1rpx solid #eee4c8; }
.f-name { color: #4e7a68; font-weight: 600; }
