.lab { font-weight: 600; margin-bottom: 12rpx; }
.inp, .ta {
  background: #f2ecd9;
  border-radius: 10rpx;
  padding: 14rpx 18rpx;
  margin-bottom: 16rpx;
  width: auto;
}
.ta { height: 140rpx; }
.msg {
  position: fixed;
  top: 20%;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(0, 0, 0, 0.75);
  color: #fffdf6;
  padding: 14rpx 32rpx;
  border-radius: 12rpx;
  z-index: 99;
}
.n-item { display: flex; flex-direction: column; padding: 12rpx 0; border-bottom: 1rpx solid #f2f2f2; }
.n-title { font-weight: 600; }
.sw-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx dashed #e3d9bd;
  font-size: 28rpx;
}
.mode-tip { font-size: 22rpx; line-height: 1.5; margin-bottom: 6rpx; }
.mode-pick {
  min-width: 150rpx;
  text-align: center;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #5f8d7c;
  background: #e8f0ec;
  border: 1rpx solid #b9d2c7;
}
.mode-pick.mode-1 { color: #a8621b; background: #fbf0dd; border-color: #e3c99a; }
.mode-pick.mode-2 { color: #9b9b9b; background: #f2f2f2; border-color: #dcdcdc; }
.g-ta { height: auto; min-height: 200rpx; }
.row-btns { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 12rpx; }
.g-builtin { flex: 1; min-width: 45%; margin-top: 0; box-sizing: border-box; text-align: center; }
.g-del {
  margin-top: 6rpx;
  align-self: flex-end;
  font-size: 24rpx;
  color: #c0392b;
  font-weight: 600;
  padding: 4rpx 16rpx;
  border: 1rpx solid #e6b0a5;
  border-radius: 999rpx;
}
.g-manage { display: block; }
.g-line1 { display: flex; align-items: center; gap: 14rpx; }
.g-line1 .n-title { flex: 1; }
.g-pin-btn {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #b05a1a;
  font-weight: 600;
  padding: 4rpx 16rpx;
  border: 1rpx solid #e0c193;
  border-radius: 999rpx;
}
.g-pin-btn.on { color: #fff; background: #c85f50; border-color: #c85f50; }
.g-line2 { display: flex; align-items: center; gap: 12rpx; margin-top: 10rpx; font-size: 22rpx; }
.g-sort-inp {
  width: 120rpx;
  padding: 6rpx 12rpx;
  border: 1rpx solid #d8cba8;
  border-radius: 8rpx;
  background: #fffdf6;
  font-size: 24rpx;
  text-align: center;
}
.g-sort-save {
  color: #4e7a68;
  font-weight: 600;
  padding: 4rpx 16rpx;
  border: 1rpx solid #9fbfae;
  border-radius: 999rpx;
}
.g-form-row {
  display: flex;
  align-items: center;
  gap: 30rpx;
  margin: 14rpx 0 4rpx;
  padding: 10rpx 16rpx;
  background: #f6f1e0;
  border: 1rpx solid #e0d6ba;
  border-radius: 10rpx;
}
.g-pin-cell { display: flex; align-items: center; gap: 8rpx; font-size: 26rpx; font-weight: 600; color: #4e7a68; }
.g-sort-cell { display: flex; align-items: center; gap: 12rpx; font-size: 24rpx; flex: 1; }
